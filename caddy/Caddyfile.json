pve.carlsbox.drive {
        tls internal
        reverse_proxy 192.x.x.x:8080
        redir /.well-known/carddav /remote.php/dav 301
        redir /.well-known/caldav /remote.php/dav 301
}

pve.carlsbox.music {
        tls internal
        reverse_proxy 192.x.x.x:4533
}

pve.carlsbox.tv {
        tls internal
        reverse_proxy 192.x.x.x:8096
}
